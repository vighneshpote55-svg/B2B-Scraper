# Copy this to ".env" and adjust if needed:  cp .env.example .env
#
# This local setup binds the scraper to 127.0.0.1 only, so NO API key is required.
# (The scraper image has no built-in authentication — localhost binding is the boundary.)

SCRAPER_BASE_URL=http://localhost:8085

# Only needed if you later expose the scraper beyond localhost behind an auth proxy
# (e.g. Caddy/nginx that checks an X-API-Key header). Leave blank for local use.
SCRAPER_API_KEY=
SCRAPER_PORT=8085

# Supabase Cloud Integration
# Note: Database tables (leads, scrape_history, users) enforce Row Level Security (RLS)
# with least-privilege policies. The server requires your private service_role key
# (Project Settings -> API -> Project API keys) to bypass RLS and sync backend data.
# Never expose the service_role key to browser clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-secret-key
SUPABASE_TABLE=leads
SUPABASE_AUTO_SYNC=true
