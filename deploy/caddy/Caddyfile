# LeadMap Pro — Production Caddy Configuration
# Reverse Proxy with Automated TLS, HSTS, and Hardened Security Headers

{
    admin off
    email {$ACME_EMAIL:admin@example.com}
    log {
        output stdout
        format json
        level INFO
    }
}

{$LEADMAP_DOMAIN:leadmap.example.com} {
    # Automatic TLS with modern cipher suites
    tls {
        protocols tls1.2 tls1.3
    }

    # Encode responses using modern compression algorithms
    encode zstd gzip

    # Hardened Security & Privacy Headers
    header {
        # Enforce HTTPS across all subdomains (2 years HSTS)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking defense (deny all framing)
        X-Frame-Options "DENY"
        # Referrer privacy policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Strict Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self';"
        # Restrict browser capabilities
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
        # Remove server identity header
        -Server
    }

    # Rate limiting on authentication routes (optional if caddy-ratelimit plugin loaded)
    @authRoutes {
        path /api/auth/*
    }

    # Reverse proxy to LeadMap Pro backend bound strictly on loopback
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }
}
